# Placeholders only. Copy to .env (git-ignored) and fill in with a TRIAL/TEST account.
FRESHDESK_DOMAIN=your-subdomain          # "acme" for acme.freshdesk.com
FRESHDESK_API_KEY=your-api-key-here      # Profile Settings > API Key
# Optional
FRESHDESK_TIMEOUT=15                     # seconds per request
FRESHDESK_MAX_RETRIES=3                  # retries for 429 / 5xx / timeouts
FRESHDESK_MAX_RETRY_WAIT=60              # never sleep longer than this (seconds) for one retry
